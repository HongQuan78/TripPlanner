ConnectionStrings__DefaultConnection=Host=<host>;Port=<port>;Database=<db>;Username=<user>;Password=<password>;SSL Mode=Require;SSL Negotiation=Direct;Trust Server Certificate=true
# HS256 signing key for JWTs (use a long random string, at least 32 chars).
JwtSettings__SecretKey=
# OpenTripMap API key (https://opentripmap.io/).
OpenTripMapSettings__ApiKey=
EmailSettings__Provider=Resend
EmailSettings__FromAddress=no-reply@tripplanner.local
EmailSettings__FromName=TripPlanner
EmailSettings__VerificationUrlBase=http://localhost:5173/verify-email
EmailSettings__TokenExpiryHours=24
ResendSettings__ApiKey=
ResendSettings__SmtpHost=smtp.resend.com
ResendSettings__SmtpPort=587
ResendSettings__TimeoutMilliseconds=10000
# GoogleSmtpSettings is only required when EmailSettings__Provider=Google.
# AppPassword is a Google App Password (Account > Security > 2-Step Verification >
# App passwords), NOT your Gmail login password; 2-Step Verification must be enabled.
# Note: Gmail's SMTP relay rewrites the message From to the authenticated Username
# account unless it is a verified "Send mail as" alias, so EmailSettings__FromAddress
# is effectively overridden when Provider=Google.
GoogleSmtpSettings__Username=
GoogleSmtpSettings__AppPassword=
GoogleSmtpSettings__SmtpHost=smtp.gmail.com
GoogleSmtpSettings__SmtpPort=587
GoogleSmtpSettings__TimeoutMilliseconds=10000
WikipediaSettings__BaseUrl=https://en.wikipedia.org/api/rest_v1/
WikipediaSettings__TimeoutMilliseconds=5000
PhotonSettings__BaseUrl=https://photon.komoot.io/api/
PhotonSettings__TimeoutMilliseconds=5000
# OpenStreetMap Overpass API — keyless source for destination opening_hours
# (OpenTripMap xids are OSM ids). No API key required.
OverpassSettings__BaseUrl=https://overpass-api.de/api/
OverpassSettings__TimeoutMilliseconds=5000
OverpassSettings__CacheMinutes=1440
