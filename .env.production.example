# Copy this file to `.env` (kept out of git) and fill in real values before running
# `docker compose up`. Docker Compose auto-loads `.env` from this directory for the
# ${...} substitutions in docker-compose.yml. No secrets are baked into the images.

# --- PostgreSQL (the `db` service) ---
# WARNING: Postgres honors these three ONLY when it initializes an empty data
# directory. Changing them later does NOT rotate the credentials — the `pgdata`
# volume keeps the original role while the API connects with the new values, and
# you get `28P01 password authentication failed` plus an API crash loop. To rotate
# for real, either `ALTER ROLE ... PASSWORD` inside the running db container, or
# destroy the volume (`docker compose down -v`, which erases all data) first.
POSTGRES_DB=tripplanner
POSTGRES_USER=tripplanner
POSTGRES_PASSWORD=change-me-strong-password

# Which server the API connects to. `db` is the bundled Postgres container that
# docker-compose.yml starts; leave it as-is for the standard single-box deployment.
# Point POSTGRES_HOST at a managed/external Postgres (RDS, Neon, Supabase, another
# host) to use that instead — the three variables above then describe the REMOTE
# database and role, not the bundled one.
# Caveat: the bundled `db` container still starts and `api` still waits for it to be
# healthy, it is simply never connected to. Run `docker compose stop db` afterwards if
# you want it gone. Unset or empty falls back to the defaults shown here.
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Extra Npgsql options appended to the connection string, `;`-separated, with NO
# leading `;` (one is already emitted for you). Leave blank for the bundled `db`.
# Most managed providers require TLS: SSL Mode=Require;Trust Server Certificate=true
POSTGRES_OPTIONS=

# --- Redis (the `redis` service) ---
# The API caches external-provider responses (OpenTripMap place details, Photon
# geocoding) in Redis. The default below targets the in-network `redis` service that
# docker-compose.yml starts: it is not a secret and the port is not published to the
# host. Point this at a managed/external Redis by replacing the value (StackExchange
# .Redis syntax, e.g. `my-cache.example.net:6380,password=...,ssl=true`). Setting it
# EMPTY is supported and makes the API fall back to a per-process in-memory cache —
# startup still succeeds, but the cache is no longer shared across API replicas and is
# lost on restart, while the `redis` container keeps running unused.
# docker-compose.yml defaults this to redis:6379 when the variable is unset or empty.
ConnectionStrings__Redis=redis:6379

# --- API secrets / config ---
# HS256 signing key for JWTs (use a long random string).
JwtSettings__SecretKey=change-me-at-least-32-chars-long-secret
# OpenTripMap API key (https://opentripmap.io/).
OpenTripMapSettings__ApiKey=your-opentripmap-api-key

# --- Email verification ---
# Provider selects the transport: Resend (default) or Google.
EmailSettings__Provider=Resend
EmailSettings__FromAddress=no-reply@tripplanner.local
EmailSettings__FromName=TripPlanner
# Point this at the deployed SPA's verify page so links open the frontend.
EmailSettings__VerificationUrlBase=http://localhost:8080/verify-email
EmailSettings__TokenExpiryHours=24

# Fill in ONLY the selected provider's transport credentials.
# Resend (Provider=Resend): SMTP relay password is the Resend API key.
ResendSettings__ApiKey=
# Google (Provider=Google): Gmail address + a Google App Password.
GoogleSmtpSettings__Username=
GoogleSmtpSettings__AppPassword=

# --- Startup behavior ---
# Applies pending EF Core migrations before the API serves requests. Default is
# `true` when unset or unparseable; set exactly `false` to disable. Accepts only
# `true`/`false` — not `1`, `0`, `yes`, or `on`.
# RunMigrationsOnStartup=true
